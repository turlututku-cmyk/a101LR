{
    "name": "a101lr",
    "main": "worker/index.js",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": ".",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
    },
    "durable_objects": {
        "bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }]
}
